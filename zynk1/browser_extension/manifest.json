{
    "manifest_version": 3,
    "name": "Zynk1 Authenticator",
    "version": "0.3.0",
    "description": "Manages ZKP secrets for Zynk1 authentication.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost:3000/*",
                "http://127.0.0.1:3000/*",
                "http://localhost:3001/*",
                "http://127.0.0.1:3001/*",
                "http://localhost:5000/*",
                "http://127.0.0.1:5000/*"
            ],
            "js": ["content.js"]
        }
    ]
}
